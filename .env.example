# Copia este archivo a .env y completa los valores
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=db_cabalgatas
DB_HOST=localhost
DB_PORT=5432
POSTGRES_TEST_DB=db_cabalgatas_test
JWT_SECRET=<base64 de al menos 32 bytes>
PORT=3000

# Correo (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Cabalgatas Salento <no-reply@cabalgatasalento.com>"

# Google Calendar (Service Account)
# Pasos: Google Cloud Console → Habilitar Calendar API → Crear Service Account →
# Descargar JSON → pegar su contenido aquí como una sola línea (sin saltos de línea)
GOOGLE_CREDENTIALS_JSON=
# ID del calendario compartido con el Service Account (Google Calendar → Configuración → ID del calendario)
GOOGLE_CALENDAR_ID=primary

# Notificaciones programadas al admin
# Expresión cron: por defecto 7am hora Colombia (12pm UTC)
NOTIFICACIONES_CRON=0 12 * * *
# Días hacia adelante que abarca el resumen del cron diario
NOTIFICACIONES_DIAS_DEFECTO=7
