{
  "info": {
    "_postman_id": "cbs-col-2024",
    "name": "Cabalgatas Salento",
    "description": "Colección completa de endpoints de la API REST de Cabalgatas Salento.\n\n**Orden recomendado de ejecución:** Auth → Rutas → Caballos → Guías → Salidas → Reservaciones.\n\nLos scripts de test guardan automáticamente tokens e IDs en las variables de entorno.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Registro Admin (solo sin admins existentes)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"primerNombre\": \"Super\",\n  \"primerApellido\": \"Admin\",\n  \"tipoDocumento\": \"CEDULA\",\n  \"fechaNacimiento\": \"1985-06-20\",\n  \"documento\": \"1000000001\",\n  \"email\": \"admin@salento.com\",\n  \"password\": \"Admin1234!\",\n  \"telefono\": \"+573001234567\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/registro-admin",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "registro-admin"]
            },
            "description": "Crea el primer usuario ADMIN. Solo funciona cuando no existe ningún admin en el sistema."
          }
        },
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.environment.set('tokenAdmin', body.token);",
                  "    pm.environment.set('adminId', body.userId);",
                  "    console.log('Token admin guardado. userId:', body.userId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@salento.com\",\n  \"password\": \"Admin1234!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Autentica al admin y guarda automáticamente `tokenAdmin` y `adminId` en las variables de entorno."
          }
        },
        {
          "name": "Registro Cliente",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"primerNombre\": \"Ana\",\n  \"primerApellido\": \"García\",\n  \"tipoDocumento\": \"CEDULA\",\n  \"fechaNacimiento\": \"1995-03-20\",\n  \"documento\": \"1234567890\",\n  \"email\": \"cliente@example.com\",\n  \"password\": \"Cliente123!\",\n  \"telefono\": \"+573109876543\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/registro",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "registro"]
            },
            "description": "Registra un nuevo usuario con rol CLIENTE."
          }
        },
        {
          "name": "Login Cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.environment.set('tokenCliente', body.token);",
                  "    pm.environment.set('clienteId', body.userId);",
                  "    console.log('Token cliente guardado. userId:', body.userId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@example.com\",\n  \"password\": \"Cliente123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Autentica al cliente y guarda automáticamente `tokenCliente` y `clienteId` en las variables de entorno."
          }
        }
      ]
    },
    {
      "name": "02 - Rutas",
      "item": [
        {
          "name": "Listar rutas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rutas",
              "host": ["{{baseUrl}}"],
              "path": ["rutas"]
            },
            "description": "Público. Devuelve todas las rutas disponibles."
          }
        },
        {
          "name": "Obtener ruta por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rutas/{{rutaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["rutas", "{{rutaId}}"]
            },
            "description": "Público. Devuelve el detalle de una ruta."
          }
        },
        {
          "name": "Crear ruta (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.environment.set('rutaId', body.id);",
                  "    console.log('rutaId guardado:', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ruta Valle del Quindío\",\n  \"descripcion\": \"Recorrido por cafetales y miradores con vistas al valle\",\n  \"precio\": 75000.00,\n  \"dificultad\": \"FACIL\",\n  \"duracionMinutos\": 90,\n  \"imageUrl\": \"https://example.com/ruta-valle.jpg\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/rutas",
              "host": ["{{baseUrl}}"],
              "path": ["rutas"]
            },
            "description": "Requiere ADMIN. Guarda el `rutaId` automáticamente para las siguientes peticiones.\n\nValores de `dificultad`: FACIL, MEDIA, DIFICIL."
          }
        },
        {
          "name": "Actualizar ruta (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ruta Valle del Quindío — Actualizada\",\n  \"descripcion\": \"Recorrido por cafetales, miradores y el río\",\n  \"precio\": 80000.00,\n  \"dificultad\": \"MEDIA\",\n  \"duracionMinutos\": 120,\n  \"imageUrl\": \"https://example.com/ruta-valle-v2.jpg\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/rutas/{{rutaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["rutas", "{{rutaId}}"]
            },
            "description": "Requiere ADMIN. Reemplaza todos los campos de la ruta."
          }
        },
        {
          "name": "Activar ruta (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/rutas/{{rutaId}}/activar",
              "host": ["{{baseUrl}}"],
              "path": ["rutas", "{{rutaId}}", "activar"]
            },
            "description": "Requiere ADMIN. Marca la ruta como activa (is_active = true)."
          }
        },
        {
          "name": "Desactivar ruta (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/rutas/{{rutaId}}/desactivar",
              "host": ["{{baseUrl}}"],
              "path": ["rutas", "{{rutaId}}", "desactivar"]
            },
            "description": "Requiere ADMIN. Marca la ruta como inactiva (is_active = false)."
          }
        },
        {
          "name": "Eliminar ruta (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/rutas/{{rutaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["rutas", "{{rutaId}}"]
            },
            "description": "Requiere ADMIN. Borrado lógico: marca `eliminado = true`. Irreversible."
          }
        }
      ]
    },
