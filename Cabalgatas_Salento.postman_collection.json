            ],
            "url": {
              "raw": "{{baseUrl}}/caballos/{{caballoId}}/desactivar",
              "host": ["{{baseUrl}}"],
              "path": ["caballos", "{{caballoId}}", "desactivar"]
            },
            "description": "Requiere ADMIN. Marca el caballo como no disponible."
          }
        },
        {
          "name": "Eliminar caballo (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/caballos/{{caballoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["caballos", "{{caballoId}}"]
            },
            "description": "Requiere ADMIN. Borrado lógico: marca `eliminado = true`. Irreversible."
          }
        }
      ]
    },
